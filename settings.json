{
  "permissions": {
    "allow": [
      "Bash(git -C d:\\\\projects\\\\dev\\\\webdemo202508 log --oneline -20)",
      "Bash(dir \"d:\\\\projects\\\\dev\\\\webdemo202508\" /b)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Skill(superpowers:brainstorming)",
      "Skill(superpowers:brainstorming:*)",
      "Bash(Get-ChildItem -Path \"d:\\\\projects\\\\dev\\\\webdemo202508\" -Directory)",
      "Bash(Select-Object Name)",
      "Bash(curl -s http://localhost:8000/api/v1/content/blocks/page/home)",
      "PowerShell(claude plugins marketplace add https://github.com/msitarzewski/agency-agents 2>&1)",
      "PowerShell($tmpDir = \"$env:TEMP\\\\agency-agents-inspect\"; if \\(Test-Path $tmpDir\\) { Remove-Item $tmpDir -Recurse -Force }; git clone --depth 1 https://github.com/msitarzewski/agency-agents $tmpDir 2>&1; Get-ChildItem $tmpDir | Select-Object Name, Mode)",
      "PowerShell(Get-ChildItem \"$env:TEMP\\\\agency-agents-inspect\" -Recurse | Select-Object FullName)",
      "Bash(Get-Date)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "printf '【post-compact reminder】\\n1) 不直接 commit 主线 — 所有改动开子分支 (feature/dev/jin.demo.<topic>)，merge 用 --no-ff\\n2) verification-before-completion — 真跑命令再宣告完成，evidence > claims\\n3) progress.md 是任务状态唯一真相源 — 不确定上下文时先 cat progress.md\\n4) 重输出派 subagent — 长日志/批量调研不要装进主会话\\n'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/agent-loader.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-3lines.sh\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "andrej-karpathy-skills@karpathy-skills": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/multica-ai/andrej-karpathy-skills.git"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "model": "opus"
}
