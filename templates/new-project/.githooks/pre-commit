#!/usr/bin/env bash
# Block direct commits to protected main branches.
set -euo pipefail

PROTECTED_BRANCHES=("main" "[MAIN_BRANCH]")
CURRENT="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

for branch in "${PROTECTED_BRANCHES[@]}"; do
  if [[ "$CURRENT" == "$branch" ]]; then
    git_dir="$(git rev-parse --git-dir)"
    [[ -f "$git_dir/MERGE_HEAD" ]] && exit 0
    [[ -f "$git_dir/CHERRY_PICK_HEAD" ]] && exit 0
    [[ -f "$git_dir/REVERT_HEAD" ]] && exit 0
    echo "Direct commits to protected branch '$branch' are blocked." >&2
    echo "Create a work branch first, for example:" >&2
    echo "  git checkout -b $branch.<topic>" >&2
    exit 1
  fi
done

exit 0
