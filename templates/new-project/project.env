# ============================================================
# 新项目配置文件 — 填完后运行 bash init.sh 自动完成初始化
# ============================================================

# ---------- 基本信息 ----------
PROJECT_NAME=my-app          # 项目英文名，用于标题
PHASE=开发                    # 当前阶段：开发 / MVP / Beta / GA
MAIN_BRANCH=main             # git 主线分支名：main / master / develop

# ---------- 目录名（影响 path-scoped 规则触发路径）----------
BACKEND_DIR=backend          # 后端根目录名，如 api / server
FRONTEND_DIR=frontend        # 前端根目录名，如 web / app

# ---------- 一句话技术栈（用于 CLAUDE.md 摘要）----------
BACKEND_STACK=FastAPI + PostgreSQL
FRONTEND_STACK=Next.js 14 + TypeScript
INFRA=Docker Compose + GitHub Actions

# ---------- 后端技术栈详情（用于 stack-backend.md）----------
BACKEND_LANGUAGE_VERSION=Python 3.11      # 如 Node 20 / Go 1.22 / Java 21
BACKEND_FRAMEWORK=FastAPI                  # 如 Express / Gin / Spring Boot
ORM_AND_MIGRATIONS=SQLAlchemy + Alembic   # 如 Prisma / Drizzle / GORM
DATABASE=PostgreSQL 15                     # 如 MySQL 8 / MongoDB 7
TEST_FRAMEWORK_BACKEND=pytest              # 如 Jest / go test / JUnit

# ---------- 前端技术栈详情（用于 stack-frontend.md）----------
FRONTEND_FRAMEWORK=Next.js 14 App Router  # 如 React + Vite / Vue 3 / Nuxt
FRONTEND_LANGUAGE=TypeScript 5            # 如 JavaScript
STYLING=Tailwind CSS 3                    # 如 CSS Modules / Styled Components
STATE_MGMT=TanStack Query                 # 如 Zustand / Redux Toolkit（无则留空）
TEST_FRAMEWORK_FRONTEND=Jest + Playwright # 如 Vitest + Cypress
